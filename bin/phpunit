#!/usr/bin/env php
<?php

// Force le fuseau horaire si non défini
if (!ini_get('date.timezone')) {
    ini_set('date.timezone', 'UTC');
}

$baseDir = dirname(__DIR__);
$phpunitPath = $baseDir . '/vendor/phpunit/phpunit/phpunit';
$simplePhpunitPath = $baseDir . '/vendor/symfony/phpunit-bridge/bin/simple-phpunit.php';
$autoloadPath = $baseDir . '/vendor/autoload.php';

if (is_file($phpunitPath)) {
    // Pour PHP 8.0 et plus, on utilise directement PHPUnit
    if (PHP_VERSION_ID >= 80000) {
        require $phpunitPath;
    } else {
        // Pour les versions de PHP < 8.0
        define('PHPUNIT_COMPOSER_INSTALL', $autoloadPath);
        require $autoloadPath;
        PHPUnit\TextUI\Command::main();
    }
} elseif (is_file($simplePhpunitPath)) {
    require $simplePhpunitPath;
} else {
    echo " Impossible de trouver `simple-phpunit.php` dans `vendor/symfony/phpunit-bridge/bin/`.\n";
    exit(1);
}
